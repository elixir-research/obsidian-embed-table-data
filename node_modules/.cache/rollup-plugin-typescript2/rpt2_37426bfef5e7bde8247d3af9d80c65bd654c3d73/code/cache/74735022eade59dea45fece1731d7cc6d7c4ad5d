{"code":"export function resolveVariables(body, rows, column) {\n    const missing = new Set();\n    const resolvedBody = body.replace(/\\{([^}]+)\\}/g, (match, rowNameRaw) => {\n        const rowName = rowNameRaw.trim();\n        if (!rowName)\n            return match;\n        const row = rows[rowName];\n        const value = row?.[column];\n        if (value === undefined || value === null || value === \"\") {\n            missing.add(rowName);\n            return match;\n        }\n        return value;\n    });\n    return {\n        resolvedBody,\n        missingRowNames: Array.from(missing)\n    };\n}\n","references":["/Users/ahmadhalwani/c_space/obsidian-embed-table-data/src/tableParser.ts"]}
